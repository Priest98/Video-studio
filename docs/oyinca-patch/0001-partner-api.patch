@@ -0,0 +1,43 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { assertSafeVideoUrl, generateToken, handleFromMetadata, hashToken, normaliseScopes, readCapped } from './partner.util.ts';
+
+const hosts = ['files.example.com'];
+
+test('tokens are prefixed, unique, and only the hash is derivable', () => {
+  const a = generateToken(), b = generateToken();
+  assert.ok(a.token.startsWith('ptk_') && a.token !== b.token);
+  assert.equal(hashToken(a.token), a.tokenHash);
+  assert.notEqual(a.tokenHash, a.token);
+});
+
+test('scopes are filtered to the known set and de-duplicated', () => {
+  assert.deepEqual(normaliseScopes(['submissions:create', 'admin', 'submissions:create', 7]), ['submissions:create']);
+  assert.deepEqual(normaliseScopes(undefined), []);
+});
+
+test('video URL guard accepts allowlisted https hosts and subdomains', () => {
+  assert.equal(assertSafeVideoUrl('https://files.example.com/a.mp4?sig=1', hosts).hostname, 'files.example.com');
+  assert.equal(assertSafeVideoUrl('https://acct.files.example.com/a.mp4', hosts).hostname, 'acct.files.example.com');
+});
+
+test('video URL guard blocks SSRF shapes', () => {
+  for (const bad of [
+    'http://files.example.com/a.mp4', 'https://evil.com/a.mp4', 'https://files.example.com.evil.com/a.mp4',
+    'https://127.0.0.1/a.mp4', 'https://169.254.169.254/latest/meta-data', 'https://localhost/a.mp4', 'https://[::1]/a.mp4',
+    'https://user:pw@files.example.com/a.mp4', 'https://files.example.com:8443/a.mp4', 'not a url',
+  ]) assert.throws(() => assertSafeVideoUrl(bad, hosts), undefined, bad);
+  assert.throws(() => assertSafeVideoUrl('https://files.example.com/a.mp4', []));
+});
+
+test('handle parsing tolerates bad metadata', () => {
+  assert.equal(handleFromMetadata('{"username":"adam"}'), 'adam');
+  assert.equal(handleFromMetadata('not json'), undefined);
+  assert.equal(handleFromMetadata(null), undefined);
+});
+
+test('capped reader stops oversized bodies', async () => {
+  const stream = (n: number) => new ReadableStream<Uint8Array>({ start(c) { c.enqueue(new Uint8Array(n)); c.close(); } });
+  assert.equal((await readCapped(stream(100), 200)).length, 100);
+  await assert.rejects(readCapped(stream(300), 200), /size limit/);
+});
diff --git a/apps/api/src/partner/partner.util.ts b/apps/api/src/partner/partner.util.ts
new file mode 100644
index 0000000..2cb0e4d
--- /dev/null
+++ b/apps/api/src/partner/partner.util.ts
@@ -0,0 +1,67 @@
+// Pure helpers for the partner API. Kept free of Nest and Prisma imports so they can be unit tested on their own.
+import { createHash, randomBytes } from 'node:crypto';
+
+export const PARTNER_SCOPES = ['accounts:read', 'submissions:create'] as const;
+export type PartnerScope = (typeof PARTNER_SCOPES)[number];
+export const TOKEN_PREFIX = 'ptk_';
+
+export function generateToken(): { token: string; tokenHash: string } {
+  const token = TOKEN_PREFIX + randomBytes(32).toString('base64url');
+  return { token, tokenHash: hashToken(token) };
+}
+
+export function hashToken(token: string): string {
+  return createHash('sha256').update(token).digest('hex');
+}
+
+export function normaliseScopes(requested: unknown): PartnerScope[] {
+  const list = Array.isArray(requested) ? requested : [];
+  const valid = list.filter((s): s is PartnerScope => (PARTNER_SCOPES as readonly string[]).includes(s));
+  return Array.from(new Set(valid));
+}
+
+/**
+ * Only fetch partner videos from hosts the operator allowlisted (PARTNER_ALLOWED_VIDEO_HOSTS), over https, with no
+ * credentials in the URL, no IP literals and no non-default ports. This is the SSRF guard for the submission endpoint.
+ */
+export function assertSafeVideoUrl(raw: string, allowedHosts: string[]): URL {
+  let url: URL;
+  try { url = new URL(raw); } catch { throw new Error('videoUrl is not a valid URL'); }
+  if (url.protocol !== 'https:') throw new Error('videoUrl must use https');
+  if (url.username || url.password) throw new Error('videoUrl must not contain credentials');
+  if (url.port && url.port !== '443') throw new Error('videoUrl must use the default https port');
+  const host = url.hostname.toLowerCase();
+  if (/^\d+\.\d+\.\d+\.\d+$/.test(host) || host.includes(':') || host === 'localhost') throw new Error('videoUrl host is not allowed');
+  const ok = allowedHosts.some((h) => host === h.toLowerCase() || host.endsWith('.' + h.toLowerCase()));
+  if (!ok) throw new Error('videoUrl host is not on the allowlist');
+  return url;
+}
+
+export function parseAllowedHosts(env: string | undefined): string[] {
