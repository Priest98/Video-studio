+
+export function handleFromMetadata(metadata: string | null | undefined): string | undefined {
+  if (!metadata) return undefined;
+  try {
+    const m = JSON.parse(metadata);
+    const v = m?.username ?? m?.handle ?? m?.display_name ?? m?.name;
