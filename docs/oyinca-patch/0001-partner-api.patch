@@ -1501,3 +1501,34 @@ model MarketingAttributionEvent {
   @@index([utmSource], map: "idx_attr_utm_source")
   @@index([createdAt], map: "idx_attr_created")
 }
+
+/// A revocable token a user issues so a partner app (e.g. Video Studio) can submit into the approval queue.
+/// Only the SHA-256 hash is stored; the token is shown once at creation.
+model PartnerConnection {
+  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
+  userId     String
+  partner    String
+  label      String
+  tokenHash  String   @unique
+  scopes     String[] @default([])
+  expiresAt  DateTime @db.Timestamptz(6)
+  revokedAt  DateTime? @db.Timestamptz(6)
+  lastUsedAt DateTime? @db.Timestamptz(6)
+  createdAt  DateTime @default(now()) @db.Timestamptz(6)
+  submissions PartnerSubmission[]
+
+  @@index([userId])
+}
+
+model PartnerSubmission {
+  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
+  connectionId   String
+  idempotencyKey String
+  brandId        String
+  postId         String?
+  mediaAssetId   String?
+  createdAt      DateTime @default(now()) @db.Timestamptz(6)
+  connection     PartnerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
+
+  @@unique([connectionId, idempotencyKey])
+}
