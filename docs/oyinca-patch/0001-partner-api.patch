@@ -0,0 +1,37 @@
+import { CanActivate, ExecutionContext, ForbiddenException, Injectable, SetMetadata, UnauthorizedException } from '@nestjs/common';
+import { Reflector } from '@nestjs/core';
+import { PrismaService } from '../prisma/prisma.service';
+import { hashToken, TOKEN_PREFIX, type PartnerScope } from './partner.util';
+
+export const REQUIRED_SCOPE = 'partner:required-scope';
+export const RequireScope = (scope: PartnerScope) => SetMetadata(REQUIRED_SCOPE, scope);
+
+export interface PartnerRequestContext {
+  connectionId: string;
+  userId: string;
+  scopes: string[];
+}
+
+/** Authenticates `Authorization: Bearer ptk_...` partner tokens. Tenant is always derived from the token owner, never from input. */
+@Injectable()
+export class PartnerTokenGuard implements CanActivate {
+  constructor(private readonly prisma: PrismaService, private readonly reflector: Reflector) {}
+
+  async canActivate(context: ExecutionContext): Promise<boolean> {
+    const request = context.switchToHttp().getRequest();
+    const header: string = request.headers?.authorization ?? '';
+    const token = header.startsWith('Bearer ') ? header.slice(7) : '';
+    if (!token.startsWith(TOKEN_PREFIX)) throw new UnauthorizedException('Invalid or expired token.');
+
+    const conn = await this.prisma.partnerConnection.findUnique({ where: { tokenHash: hashToken(token) } });
+    if (!conn || conn.revokedAt || conn.expiresAt <= new Date()) throw new UnauthorizedException('Invalid or expired token.');
+
+    const needed = this.reflector.get<PartnerScope | undefined>(REQUIRED_SCOPE, context.getHandler());
+    if (needed && !conn.scopes.includes(needed)) throw new ForbiddenException('This token does not have the required scope.');
+
+    request.partner = { connectionId: conn.id, userId: conn.userId, scopes: conn.scopes } satisfies PartnerRequestContext;
+    // Best effort; never blocks the request.
+    void this.prisma.partnerConnection.update({ where: { id: conn.id }, data: { lastUsedAt: new Date() } }).catch(() => undefined);
+    return true;
+  }
+}
