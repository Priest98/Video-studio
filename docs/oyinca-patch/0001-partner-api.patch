+import { Body, Controller, Delete, Get, Headers, Param, Post, Req, UseGuards } from '@nestjs/common';
+import { Throttle } from '@nestjs/throttler';
+import { JwtAuthGuard } from '../auth/jwt-auth.guard';
+import { PartnerService, type SubmitDto } from './partner.service';
+import { PartnerTokenGuard, RequireScope } from './partner-token.guard';
+
+/** Partner-facing API. There is deliberately no publish route: partners can only submit into the approval queue. */
+@Controller('partner/v1')
+@UseGuards(PartnerTokenGuard)
+export class PartnerController {
+  constructor(private readonly partner: PartnerService) {}
+
+  @Get('accounts')
+  @RequireScope('accounts:read')
+  accounts(@Req() req: any) {
+    return this.partner.listAccounts(req.partner.userId);
+  }
+
+  @Post('approval-queue/submissions')
+  @RequireScope('submissions:create')
+  @Throttle({ default: { limit: 60, ttl: 60_000 } })
+  submit(@Req() req: any, @Headers('idempotency-key') key: string, @Body() body: SubmitDto) {
+    return this.partner.submit(req.partner, key, body);
+  }
+}
+
+/** Signed-in users manage their own partner tokens. */
+@Controller('integrations/partner-tokens')
+@UseGuards(JwtAuthGuard)
+export class PartnerTokenController {
+  constructor(private readonly partner: PartnerService) {}
+
+  @Post()
+  @Throttle({ default: { limit: 10, ttl: 60_000 } })
+  issue(@Req() req: any, @Body() body: { label?: string; partner?: string; scopes?: string[]; ttlDays?: number }) {
+    return this.partner.issueToken(req.user.id, body);
+  }
+
+  @Get()
+  list(@Req() req: any) {
+    return this.partner.listTokens(req.user.id);
+  }
+
+  @Delete(':id')
+  revoke(@Req() req: any, @Param('id') id: string) {
+    return this.partner.revokeToken(req.user.id, id);
+  }
+}
