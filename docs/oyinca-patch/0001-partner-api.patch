+-- Partner API: revocable integration tokens and idempotent submissions into the approval queue.
+CREATE TABLE "PartnerConnection" (
+  "id" TEXT NOT NULL DEFAULT (gen_random_uuid())::text,
+  "userId" TEXT NOT NULL,
+  "partner" TEXT NOT NULL,
+  "label" TEXT NOT NULL,
+  "tokenHash" TEXT NOT NULL,
+  "scopes" TEXT[] NOT NULL DEFAULT ARRAY[]::TEXT[],
+  "expiresAt" TIMESTAMPTZ(6) NOT NULL,
+  "revokedAt" TIMESTAMPTZ(6),
+  "lastUsedAt" TIMESTAMPTZ(6),
+  "createdAt" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  CONSTRAINT "PartnerConnection_pkey" PRIMARY KEY ("id")
+);
+CREATE UNIQUE INDEX "PartnerConnection_tokenHash_key" ON "PartnerConnection"("tokenHash");
+CREATE INDEX "PartnerConnection_userId_idx" ON "PartnerConnection"("userId");
+
+CREATE TABLE "PartnerSubmission" (
+  "id" TEXT NOT NULL DEFAULT (gen_random_uuid())::text,
+  "connectionId" TEXT NOT NULL,
+  "idempotencyKey" TEXT NOT NULL,
+  "brandId" TEXT NOT NULL,
+  "postId" TEXT,
+  "mediaAssetId" TEXT,
+  "createdAt" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  CONSTRAINT "PartnerSubmission_pkey" PRIMARY KEY ("id")
+);
+CREATE UNIQUE INDEX "PartnerSubmission_connectionId_idempotencyKey_key" ON "PartnerSubmission"("connectionId", "idempotencyKey");
+ALTER TABLE "PartnerSubmission" ADD CONSTRAINT "PartnerSubmission_connectionId_fkey"
+  FOREIGN KEY ("connectionId") REFERENCES "PartnerConnection"("id") ON DELETE CASCADE ON UPDATE NO ACTION;
