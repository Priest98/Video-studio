diff --git a/apps/api/src/partner/partner.service.ts b/apps/api/src/partner/partner.service.ts
new file mode 100644
index 0000000..5ad9917
--- /dev/null
+++ b/apps/api/src/partner/partner.service.ts
@@ -0,0 +1,134 @@
+import { BadRequestException, ForbiddenException, Injectable, Logger } from '@nestjs/common';
+import { MediaStatus } from '@prisma/client';
+import { PrismaService } from '../prisma/prisma.service';
+import { MediaService } from '../media/media.service';
+import {
+  assertSafeVideoUrl, generateToken, handleFromMetadata, normaliseScopes, parseAllowedHosts, readCapped,
+} from './partner.util';
+
+export interface SubmitDto {
+  brandId: string;
+  accountId: string;
+  videoUrl: string;
+  filename: string;
+  mimeType: string;
+  sizeBytes?: number;
+  title?: string;
+  caption?: string;
+  thumbnailUrl?: string;
+  suggestedPublishAt?: string;
+}
+
+@Injectable()
+export class PartnerService {
+  private readonly logger = new Logger(PartnerService.name);
+  constructor(private readonly prisma: PrismaService, private readonly media: MediaService) {}
+
+  // ---- token management (called by the signed-in user) ----
+  async issueToken(userId: string, input: { label?: string; partner?: string; scopes?: unknown; ttlDays?: number }) {
+    const scopes = normaliseScopes(input.scopes);
+    if (!scopes.length) throw new BadRequestException('Choose at least one scope.');
+    const ttlDays = Math.min(Math.max(Number(input.ttlDays) || 90, 1), 365);
+    const { token, tokenHash } = generateToken();
+    const row = await this.prisma.partnerConnection.create({
+      data: {
+        userId, tokenHash, scopes, partner: String(input.partner ?? 'video-studio').slice(0, 40),
+        label: String(input.label ?? 'Video Studio').slice(0, 80), expiresAt: new Date(Date.now() + ttlDays * 86_400_000),
+      },
+    });
+    return { id: row.id, token, scopes, expiresAt: row.expiresAt }; // the token is returned once and never stored
+  }
+
+  listTokens(userId: string) {
+    return this.prisma.partnerConnection.findMany({
+      where: { userId }, orderBy: { createdAt: 'desc' },
+      select: { id: true, partner: true, label: true, scopes: true, expiresAt: true, revokedAt: true, lastUsedAt: true, createdAt: true },
+    });
+  }
+
+  async revokeToken(userId: string, id: string) {
+    const res = await this.prisma.partnerConnection.updateMany({ where: { id, userId, revokedAt: null }, data: { revokedAt: new Date() } });
+    return { revoked: res.count === 1 };
+  }
+
+  // ---- partner API ----
+  async listAccounts(userId: string) {
+    const accounts = await this.prisma.socialAccount.findMany({
+      where: { brand: { organization: { members: { some: { userId } } } } },
+      select: { id: true, brandId: true, platform: true, metadata: true, status: true },
+    });
+    return accounts.map((a) => ({
+      brandId: a.brandId, accountId: a.id, platform: String(a.platform), handle: handleFromMetadata(a.metadata),
+      canSubmit: a.status === 'CONNECTED',
+    }));
+  }
+
+  async submit(ctx: { connectionId: string; userId: string }, idempotencyKey: string, dto: SubmitDto) {
+    if (!idempotencyKey || idempotencyKey.length > 200) throw new BadRequestException('Idempotency-Key header is required.');
+
+    const existing = await this.prisma.partnerSubmission.findUnique({
+      where: { connectionId_idempotencyKey: { connectionId: ctx.connectionId, idempotencyKey } },
+    });
+    if (existing) return { assetId: existing.mediaAssetId ?? existing.postId, state: 'awaiting_approval' as const };
+
+    // Same rejection for "no such brand" and "not yours", so ids cannot be probed.
+    const account = await this.prisma.socialAccount.findFirst({
+      where: { id: dto.accountId, brandId: dto.brandId, status: 'CONNECTED', brand: { organization: { members: { some: { userId: ctx.userId } } } } },
+      select: { id: true, platform: true },
+    });
+    if (!account) throw new ForbiddenException('You do not have access to this account.');
+    if (dto.mimeType !== 'video/mp4') throw new BadRequestException('Only video/mp4 is accepted.');
+
+    let url: URL;
+    try { url = assertSafeVideoUrl(dto.videoUrl, parseAllowedHosts(process.env.PARTNER_ALLOWED_VIDEO_HOSTS)); }
+    catch (e) { throw new BadRequestException((e as Error).message); }
+
+    const maxBytes = Number(process.env.PARTNER_MAX_VIDEO_BYTES ?? 100 * 1024 * 1024);
+    let buffer: Buffer;
+    try {
+      const res = await fetch(url, { redirect: 'manual', signal: AbortSignal.timeout(60_000) });
+      if (!res.ok) throw new Error(`video fetch failed (${res.status})`);
+      if (Number(res.headers.get('content-length') ?? 0) > maxBytes) throw new Error('video exceeds the size limit');
+      buffer = await readCapped(res.body, maxBytes);
+    } catch (e) {
+      throw new BadRequestException((e as Error).message);
+    }
+
+    // MediaService enforces the MIME whitelist, magic-byte check, plan storage limit and writes the asset record.
+    const asset = await this.media.uploadAsset(
+      dto.brandId,
+      { buffer, originalname: dto.filename, mimetype: 'video/mp4', size: buffer.length } as Express.Multer.File,
+      undefined, ctx.userId,
+    );
+
+    try {
+      const post = await this.prisma.$transaction(async (tx) => {
+        // NEEDS_APPROVAL with no schedule: Oyinca's own approval and scheduling decide everything after this.
+        const created = await tx.post.create({
+          data: {
+            brandId: dto.brandId, caption: String(dto.caption ?? dto.title ?? '').slice(0, 2200), status: 'NEEDS_APPROVAL',
+            postType: 'SINGLE', contentCategory: 'partner:video-studio',
+            media: { create: [{ assetId: asset.id, order: 0 }] },
+            targets: { create: [{ socialAccountId: account.id, platform: account.platform }] },
+          },
+        });
+        await tx.mediaAsset.update({ where: { id: asset.id }, data: { linkedPostId: created.id, status: MediaStatus.READY } });
+        await tx.partnerSubmission.create({
+          data: { connectionId: ctx.connectionId, idempotencyKey, brandId: dto.brandId, postId: created.id, mediaAssetId: asset.id },
+        });
+        return created;
+      });
+      return { assetId: asset.id, postId: post.id, state: 'awaiting_approval' as const };
+    } catch (e) {
+      // A concurrent request with the same key won the race: return its result instead of failing.
+      const winner = await this.prisma.partnerSubmission.findUnique({
+        where: { connectionId_idempotencyKey: { connectionId: ctx.connectionId, idempotencyKey } },
+      });
+      if (winner) {
+        this.logger.warn(`Duplicate partner submission resolved by idempotency key; orphan asset ${asset.id} may need cleanup`);
+        return { assetId: winner.mediaAssetId ?? winner.postId, state: 'awaiting_approval' as const };
+      }
+      throw e;
+    }
+  }
+}
